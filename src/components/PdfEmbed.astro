---
interface Props {
  src: string;
  title: string;
  version?: string;
  effectiveDate?: string;
  lastReviewed?: string;
  owner?: string;
  pages?: number;
  height?: string;
}

const {
  src,
  title,
  version,
  effectiveDate,
  lastReviewed,
  owner,
  pages,
  height = '80vh',
} = Astro.props;
---

<div class="pdf-embed-wrapper">
  <header class="pdf-meta">
    <h2 class="pdf-title">{title}</h2>
    {(version || effectiveDate || lastReviewed || owner || pages) && (
      <dl class="pdf-meta-list">
        {version       && <><dt>Version</dt><dd>{version}</dd></>}
        {effectiveDate && <><dt>Effective</dt><dd>{effectiveDate}</dd></>}
        {lastReviewed  && <><dt>Last reviewed</dt><dd>{lastReviewed}</dd></>}
        {owner         && <><dt>Owner</dt><dd>{owner}</dd></>}
        {pages         && <><dt>Pages</dt><dd>{pages}</dd></>}
      </dl>
    )}
    <div class="pdf-actions">
      <a href={src} target="_blank" rel="noopener" class="pdf-action-primary">Open in new tab</a>
      <a href={src} download class="pdf-action-secondary">Download PDF</a>
    </div>
  </header>

  <object
    data={src}
    type="application/pdf"
    class="pdf-frame"
    aria-label={title}
    style={`height: ${height}`}
  >
    <div class="pdf-fallback">
      <p>This browser cannot display the PDF inline (common on mobile). Use the links below:</p>
      <ul>
        <li><a href={src} target="_blank" rel="noopener">Open in new tab</a></li>
        <li><a href={src} download>Download PDF</a></li>
      </ul>
    </div>
  </object>
</div>

<style>
  .pdf-embed-wrapper {
    margin: 1.5rem 0;
  }

  .pdf-meta {
    background: var(--sl-color-bg-sidebar, #f8f8f8);
    border: 1px solid var(--sl-color-hairline, #ddd);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
  }

  .pdf-title {
    font-size: var(--sl-text-h3, 1.25rem);
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--sl-color-text, inherit);
    line-height: 1.3;
  }

  .pdf-meta-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
    margin: 0 0 0.875rem;
    font-size: var(--sl-text-sm, 0.875rem);
  }

  .pdf-meta-list dt {
    font-weight: 600;
    color: var(--sl-color-gray-3, #555);
    white-space: nowrap;
  }

  .pdf-meta-list dd {
    margin: 0;
    color: var(--sl-color-text, inherit);
  }

  .pdf-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pdf-action-primary,
  .pdf-action-secondary {
    font-size: var(--sl-text-sm, 0.875rem);
    padding: 0.375rem 0.875rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: background 150ms ease, color 150ms ease;
  }

  .pdf-action-primary {
    background: var(--sl-color-accent, #3D5C3E);
    color: #fff;
    border: 1px solid var(--sl-color-accent, #3D5C3E);
  }

  .pdf-action-primary:hover {
    background: var(--sl-color-accent-high, #2a4229);
  }

  .pdf-action-secondary {
    background: transparent;
    color: var(--sl-color-accent, #3D5C3E);
    border: 1px solid var(--sl-color-accent, #3D5C3E);
  }

  .pdf-action-secondary:hover {
    background: var(--sl-color-accent-low, rgba(61,92,62,0.1));
  }

  .pdf-frame {
    display: block;
    width: 100%;
    border: 1px solid var(--sl-color-hairline, #ddd);
    border-radius: 6px;
    background: #fff;
  }

  .pdf-fallback {
    padding: 2rem;
    text-align: center;
    color: var(--sl-color-gray-3, #555);
    font-size: var(--sl-text-sm, 0.875rem);
  }

  .pdf-fallback ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .pdf-fallback a {
    color: var(--sl-color-accent, #3D5C3E);
    font-weight: 600;
    text-decoration: none;
  }

  .pdf-fallback a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .pdf-meta-list {
      grid-template-columns: 1fr;
    }

    .pdf-meta-list dt {
      margin-top: 0.5rem;
    }

    .pdf-meta-list dt:first-child {
      margin-top: 0;
    }

    .pdf-frame {
      height: 60vh !important;
    }

    .pdf-action-primary {
      flex: 1;
      text-align: center;
    }
  }
</style>
